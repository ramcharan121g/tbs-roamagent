# TBS RoamAgent - Environment Configuration
NEXT_PUBLIC_APP_MODE=demo

# Optional: Supabase configuration (if not provided, RoamAgent uses in-memory local demo repository)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: AI Provider (default: demo for zero-cost reliable local execution)
AI_PROVIDER=demo
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
